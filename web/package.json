{
  "name": "acceptance-spec-system-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "pnpm typecheck && rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "pnpm typecheck && rimraf dist && vite build --mode staging",
    "report": "pnpm typecheck && rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "test": "pnpm test:vitest && pnpm test:node",
    "test:vitest": "vitest run",
    "test:coverage": "pnpm test:vitest:coverage && pnpm test:node",
    "test:vitest:coverage": "vitest run --coverage --coverage.reporter=cobertura --coverage.reporter=json-summary",
    "test:node": "node --experimental-strip-types --import ./tests/setup-node-test-cwd.mjs --test ./tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:typecheck": "tsc --project tsconfig.e2e.json --noEmit",
    "test:bundle-budget": "node --test scripts/assert-bundle-budget.test.mjs",
    "check:bundle-budget": "node scripts/assert-bundle-budget.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "svgo": "svgo -f . -r",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0 \"src/**/*.{vue,js,ts,tsx}\" \"mock/**/*.{vue,js,ts,tsx}\" \"build/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:check": "eslint --max-warnings 0 \"src/**/*.{vue,js,ts,tsx}\" \"mock/**/*.{vue,js,ts,tsx}\" \"build/**/*.{vue,js,ts,tsx}\" \"e2e/**/*.{vue,js,ts,tsx}\" playwright.config.ts",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\" \"e2e/**/*.{ts,md}\" playwright.config.ts tsconfig.e2e.json",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "stylelint:check": "stylelint \"src/**/*.{html,vue,css,scss}\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "check:smart-fill": "node check-page.mjs",
    "check:smart-fill:cjs": "node check-page.js",
    "prepare": "cd .. && husky web/.husky",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "acceptance-spec",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://github.com/YourOrg/AcceptanceSpecificationSystem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YourOrg/AcceptanceSpecificationSystem.git"
  },
  "bugs": {
    "url": "https://github.com/YourOrg/AcceptanceSpecificationSystem/issues"
