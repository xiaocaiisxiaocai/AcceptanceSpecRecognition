{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;User=root;Password=CHANGE_ME;CharSet=utf8mb4;"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]
  },
  "JwtAuth": {
    "Issuer": "AcceptanceSpecSystem",
    "Audience": "AcceptanceSpecSystem.Web",
    "SigningKey": "DevOnly_ReplaceThisWithLongRandomSecret_1234567890",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7
  },
  "DataProtection": {
    "KeysPath": ".\\data-protection-keys"
  },
  "FileStorage": {
    "BasePath": "."
  },
  "ApiRateLimits": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Upload": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AiHeavy": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AuditLog": {
    "EnableAutoCleanup": true,
    "RetentionDays": 30,
    "CleanupIntervalHours": 24
  },
  "EmbeddingCacheWarmup": {
    "Enabled": false,
    "RunOnStartup": false,
    "RunAtLocalTime": "",
    "IntervalHours": 24,
    "BatchSize": 100,
    "MaxItemsPerRun": 1000
  },
  "DatabaseBackup": {
    "Enabled": false,
    "RunAtLocalTime": "02:00",
    "BackupDirectory": "/app/backups",
    "RetentionCount": 7
  },
  "AiServiceTest": {
    "LlmTimeoutSeconds": 120,
    "EmbeddingTimeoutSeconds": 15
  },
  "SemanticKernel": {
    "AzureOpenAIApiVersion": "2024-10-21"
  },
  "AuthSeed": {
    "AdminPassword": "",
    "CommonPassword": ""
  }
}
