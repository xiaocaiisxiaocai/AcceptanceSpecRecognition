{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProxyForwarding": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;User=root;Password=CHANGE_ME;CharSet=utf8mb4;"
  },
  "JwtAuth": {
    "Issuer": "AcceptanceSpecSystem",
    "Audience": "AcceptanceSpecSystem.Web",
    "SigningKey": "DevOnly_ReplaceThisWithLongRandomSecret_1234567890",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7
  },
  "BrowserAuth": {
    "RefreshCookieName": "acceptance-refresh",
    "CsrfCookieName": "acceptance-csrf",
    "CsrfHeaderName": "X-CSRF-Token",
    "CookiePath": "/",
    "CookieDomain": null,
    "CookieSameSite": "Strict",
    "CookieSecure": false,
    "AllowInsecureHttp": false
  },
  "DataProtection": {
    "KeysPath": ".\\data-protection-keys"
  },
  "FileStorage": {
    "BasePath": "."
  },
  "ApiRateLimits": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "RefreshToken": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Upload": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "AiHeavy": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AuditLog": {
    "EnableAutoCleanup": true,
    "RetentionDays": 30,
    "CleanupIntervalHours": 24,
    "MaxRecordCount": 1000000,
    "CleanupBatchSize": 1000,
    "MaxBatchesPerRun": 10
  },
  "ExecutionHistoryRetention": {
    "Enabled": true,
    "RetentionDays": 365,
    "MaxRecordCount": 100000,
    "CleanupIntervalHours": 24,
    "BatchSize": 500,
    "MaxBatchesPerRun": 10
  },
  "AuthRefreshSessionRetention": {
    "Enabled": true,
    "RetentionDaysAfterExpiry": 30,
    "MaxRecordCount": 500000,
    "CleanupIntervalHours": 24,
    "BatchSize": 500,
    "MaxBatchesPerRun": 10
  },
  "RequestTracing": {
    "HeaderName": "X-Trace-Id",
    "ClientHeaderName": "X-Client-Trace-Id"
  },
  "SlowQuery": {
    "Enabled": true,
    "ThresholdMilliseconds": 500,
    "IncludeSqlText": false
  },
  "Dashboard": {
    "TimeZoneId": "Asia/Shanghai"
  },
  "EmbeddingCacheWarmup": {
    "Enabled": false,
    "RunOnStartup": false,
    "RunAtLocalTime": "",
    "IntervalHours": 24,
    "BatchSize": 100,
    "MaxItemsPerRun": 1000
  },
  "BatchReplyCleanup": {
    "Enabled": true,
    "ObservationMode": true,
    "InitialDelaySeconds": 30,
    "CleanupIntervalMinutes": 15,
    "SessionRetentionMinutes": 240,
    "ArtifactRetentionMinutes": 1440
  },
  "OrphanFileInspection": {
    "Enabled": true,
    "ObservationMode": true,
    "InitialDelaySeconds": 60,
    "InspectionIntervalMinutes": 60,
    "GracePeriodHours": 168
  },
  "WordFileDeletionCleanup": {
    "Enabled": true,
    "InitialDelaySeconds": 30,
    "CleanupIntervalMinutes": 1,
    "BatchSize": 100
  },
  "ResourceBudgets": {
    "MaxConcurrentDocumentParsers": 8,
    "MaxConcurrentDocumentWriters": 4,
    "MaxConcurrentHighCostMatching": 8,
    "MaxDocumentBytes": 52428800,
    "MaxWriteOperations": 200000,
    "MaxMatchingItems": 50000
  },
  "DatabaseBackup": {
    "Enabled": false,
    "RunAtLocalTime": "02:00",
    "BackupDirectory": "/app/backups",
    "RetentionCount": 7
  },
  "AiServiceTest": {
    "LlmTimeoutSeconds": 120,
    "EmbeddingTimeoutSeconds": 15
  },
  "SemanticKernel": {
    "AzureOpenAIApiVersion": "2024-10-21"
  },
  "SmartConfiguration": {
    "StructureAdjudicationTimeoutSeconds": 20,
    "ColumnSemanticRecallTimeoutSeconds": 20,
    "AutoApplyConfidenceThreshold": 0.85,
    "MinimumSpecificationNonEmptyRate": 0.5,
    "GlobalRulePromotionCustomerThreshold": 2,
    "MaxLlmCallsPerRecognizeDocument": 5,
    "MaxStructureAdjudicationCallsPerDocument": 5,
    "MaxColumnSemanticRecallCallsPerDocument": 5,
    "HeaderDetectionScanRowLimit": 20,
    "MaxHeaderRowCount": 6
  },
  "AuthSeed": {
    "AdminPassword": "",
    "CommonPassword": ""
  }
}
