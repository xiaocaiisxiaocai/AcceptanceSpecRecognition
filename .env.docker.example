# Docker Compose 环境变量配置
# 复制此文件为 .env.docker 并填入实际值
# 注意：.env.docker 已加入 .gitignore，不会被提交

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=acceptance_spec_db
MYSQL_USER=acceptance
MYSQL_PASSWORD=

# API
JWT_SIGNING_KEY=
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_COMMON_PASSWORD=

# API 限流
API_RATE_LIMIT_LOGIN_PERMIT_LIMIT=10
API_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
API_RATE_LIMIT_UPLOAD_PERMIT_LIMIT=20
API_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
API_RATE_LIMIT_AI_HEAVY_PERMIT_LIMIT=30
API_RATE_LIMIT_AI_HEAVY_WINDOW_SECONDS=60

# Ollama 运行时：-1 表示请求后永久驻留；显存不足时可改为 30m 等有限时长。
# readiness 必须覆盖目标机器冷启动加载时间；启动预热失败不会阻断 API。
AI_OLLAMA_KEEP_ALIVE=-1
AI_READINESS_PROBE_TIMEOUT_SECONDS=20
AI_PRELOAD_ON_STARTUP=true

# 当前部署目标：受信任内网同站 HTTP。来源必须替换为浏览器实际访问 Web 的精确 Origin。
CORS_ORIGIN_0=http://acceptance.internal
CORS_ORIGIN_1=
BROWSER_AUTH_ALLOW_INSECURE_HTTP=true
BROWSER_AUTH_REFRESH_COOKIE_NAME=acceptance-refresh
BROWSER_AUTH_COOKIE_SECURE=false
BROWSER_AUTH_COOKIE_SAME_SITE=Strict
BROWSER_AUTH_COOKIE_DOMAIN=
APP_NETWORK_SUBNET=172.30.0.0/24

# 若以后增加 TLS 终止层，必须整体切换为以下 HTTPS 组合：
# CORS_ORIGIN_0=https://acceptance.internal.example
# BROWSER_AUTH_ALLOW_INSECURE_HTTP=false
# BROWSER_AUTH_REFRESH_COOKIE_NAME=__Host-acceptance-refresh
# BROWSER_AUTH_COOKIE_SECURE=true
# BROWSER_AUTH_COOKIE_SAME_SITE=Strict
# BROWSER_AUTH_COOKIE_DOMAIN=

# API 直连端口只绑定部署主机回环地址。
API_HOST_PORT=5290
