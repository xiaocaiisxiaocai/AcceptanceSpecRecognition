# Docker Compose 环境变量配置
# 复制此文件为 .env.docker 并填入实际值
# 注意：.env.docker 已加入 .gitignore，不会被提交

# MySQL
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=acceptance_spec_db
MYSQL_USER=acceptance
MYSQL_PASSWORD=your_mysql_password_here

# API
JWT_SIGNING_KEY=ReplaceWithAtLeast32CharacterRandomString_ChangeMe
AUTH_SEED_ADMIN_PASSWORD=YourAdminPassword@2026
AUTH_SEED_COMMON_PASSWORD=YourCommonPassword@2026

# CORS（逗号分隔多个域名）
CORS_ORIGIN_0=http://localhost
CORS_ORIGIN_1=http://127.0.0.1
